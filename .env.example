# Satu file .env.local di root dipakai semua app (dibaca oleh next.config.mjs tiap app)

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Production: isi dengan parent domain agar login berlaku di semua subdomain, ex: .noc.jarvis.biz.id
# Development (localhost): kosongkan
NEXT_PUBLIC_COOKIE_DOMAIN=

# URL tiap app
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000
NEXT_PUBLIC_JADWAL_URL=http://localhost:3001
NEXT_PUBLIC_HANDOVER_URL=http://localhost:3002
NEXT_PUBLIC_PERIZINAN_URL=http://localhost:3003
NEXT_PUBLIC_PERKEMBANGAN_URL=http://localhost:3004
